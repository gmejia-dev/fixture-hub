{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Observability": {
    "JsonConsole": true
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrations": false,
    "Seed": false
  },
  "Jwt": {
    "Issuer": "FixtureHub",
    "Audience": "FixtureHub",
    "ExpirationMinutes": 60
  }
}
