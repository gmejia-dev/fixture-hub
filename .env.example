# Opcional. Sin .env, docker-compose usa las credenciales de DEMO del README: sirven para probar
# en esta máquina (los puertos se publican solo en 127.0.0.1), nunca en un servidor.
# Para usar valores propios, copia este archivo como .env (está en .gitignore) y completa los que
# quieras: cada variable con valor reemplaza la de demo; las que quedan vacías siguen en demo.
# Docker Compose lo lee y le pasa a cada contenedor solo las variables que usa.
# Con dotnet run en desarrollo, usa user-secrets (ver README).
# Evita $ en los valores: Compose lo interpreta como el inicio de una variable.

# Contraseña del usuario sa de SQL Server: al menos 8 caracteres con 3 de estos 4 tipos:
# mayúsculas, minúsculas, números y símbolos. Va dentro de la cadena de conexión: sin ; ni comillas.
# Se fija la primera vez que se crea el volumen: para cambiarla después, docker compose down -v.
# PowerShell: "Fh1-" + [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(16))
SQLSERVER_SA_PASSWORD=

# Administrador que la Api crea al iniciar (o actualiza si la contraseña cambió).
# La contraseña debe tener al menos 12 caracteres.
Admin__Username=admin
Admin__Password=

# Clave con la que se firman los JWT (HS256): al menos 32 caracteres aleatorios.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Jwt__SigningKey=

# Zona horaria del torneo: el frontend muestra y captura las fechas en ella.
TOURNAMENT_TIME_ZONE=America/El_Salvador
