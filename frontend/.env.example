# Copia este archivo como .env.local para cambiar los valores en desarrollo.
# Los lee solo el servidor de Next.js, al ejecutarse (no al compilar).

# Dirección de la Api. En docker-compose (#6) será http://api:8080.
API_BASE_URL=http://localhost:5065

# Zona horaria del torneo: las fechas se muestran y se capturan en esta zona.
TOURNAMENT_TIME_ZONE=America/El_Salvador
